# ---- 机密：绝不入库 ----
.local/
*.secret
*.key
*.pem
*.pfx
*.p12
*.keystore
*.jks
*.ppk
.env
.env.*
!.env.example

# ---- 导出的机密数据（含真实密文，切勿提交）----
*.smk
*.ssc
*.smkexp
*.sscexp
*.db
*.db-wal
*.db-shm

# ---- 依赖 ----
node_modules/
vendor/
# 例外：Argon2 参考实现必须入库。五端编译同一份源码是跨端一致性的基础，
# 且 Windows 11 的 CNG 不提供 Argon2id，没有系统 API 可用。
# 引入方式与修改纪律见 vendor/argon2/README.md。
!vendor/
vendor/*
!vendor/argon2/
!vendor/sqlite/
Pods/
.build/
DerivedData/
build/
cmake-build-*/
obj/
bin/
packages/
.gradle/

# ---- IDE / 编辑器 ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.xcuserdatad/
xcuserdata/

# ---- 构建产物 ----
dist/
out/
*.apk
*.aab
*.ipa
*.app/
*.msix
*.msixbundle
*.exe
*.dll
*.so
*.dylib
*.msi
*.AppImage

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 临时文件 ----
*.log
*.tmp
*.bak
*~

# ---- Argon2 内置源码（由 scripts/vendor-argon2.py 同步，不直接改动）----
# 注意：vendor/argon2 需要入库，五端共用同一份实现以保证跨端一致，
# 因此这里不忽略。仅忽略编译中间产物。
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib
