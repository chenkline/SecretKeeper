# ---- 机密：绝不入库 ----
.local/
*.secret
*.key
*.pem
*.pfx
*.p12
*.keystore
*.jks
*.ppk
.env
.env.*
!.env.example

# ---- 导出的机密数据（含真实密文，切勿提交）----
*.smk
*.ssc
*.smkexp
*.sscexp
*.db
*.db-wal
*.db-shm

# ---- 依赖 ----
node_modules/
vendor/
# 例外：Argon2 参考实现必须入库。五端编译同一份源码是跨端一致性的基础，
# 且 Windows 11 的 CNG 不提供 Argon2id，没有系统 API 可用。
# 引入方式与修改纪律见 vendor/argon2/README.md。
!vendor/
vendor/*
!vendor/argon2/
!vendor/sqlite/
# mbedTLS 同样必须入库：Windows 与 Linux 两端编译同一份 3.6.7 源码，
# 版本一致是跨端密码学一致性的前提（引入说明见 vendor/mbedtls/README.md）。
# 仅忽略编译中间产物。
!vendor/mbedtls/
# FLTK 同样必须入库：桌面三端静态链接同一份 1.4.5，界面行为一致性的前提。
# 引入说明与裁剪纪律见 vendor/fltk/README.md。
!vendor/fltk/
Pods/
.build/
DerivedData/
build/
cmake-build-*/
obj/
bin/
packages/
.gradle/

# ---- IDE / 编辑器 ----
.vs/
.vscode/
.idea/
*.user
*.suo
*.userprefs
*.xcuserdatad/
xcuserdata/

# ---- 构建产物 ----
dist/
out/
*.apk
*.aab
*.ipa
*.app/
*.msix
*.msixbundle
*.exe
*.dll
*.so
*.dylib
*.msi
*.AppImage

# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- UI 设计图旧导出（不入库）----
# all.svg / all.png 是旧设计源的归档，已被 .figma-export/ 的 JSON 取代。
# 保留在本地仅供绘对（Figma 免费版无导出功能，删了拿不回来），
# 但不入库：合计约 14 MB，且 Copy as SVG 的文字已转轮廓、不可编辑。
docs/ui/all.svg
docs/ui/all.png

# ---- 临时文件 ----
*.log
*.tmp
*.bak
*~

# ---- Argon2 内置源码（由 scripts/vendor-argon2.py 同步，不直接改动）----
# 注意：vendor/argon2 需要入库，五端共用同一份实现以保证跨端一致，
# 因此这里不忽略。仅忽略编译中间产物。
*.obj
*.pdb
*.ilk
*.idb
*.exp
*.lib

# Python 缓存，不应入库
__pycache__/
*.pyc

# UI 设计调试脚本（临时文件）
# 跨平台一致性探针的输出（各平台本地跑出来的 transcript，
# 由 scripts/compare-conformance.py 比对，不入库）
conformance-*.txt
scripts/_*.py
